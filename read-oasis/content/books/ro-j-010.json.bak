  "pages": [
    {
      "page_id": "p01",
      "text": "People can observe a clear pattern when they study a river changes course. They begin by watching what changes over time and recording the order.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "People can observe a clear pattern when they study a river changes course. They begin by watching what changes over time and recording the order.",
      "timing_segments": []
    },
    {
      "page_id": "p02",
      "text": "The central idea is simple: Water moves downhill and can collect in streams and rivers. This fact explains several details that an observer can see.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "The central idea is simple: Water moves downhill and can collect in streams and rivers. This fact explains several details that an observer can see.",
      "timing_segments": [],
      "vocabulary": [
        {
          "word": "evidence",
          "definition": "Information that helps show whether an idea is true.",
          "example": "The repeated result was evidence."
        }
      ]
    },
    {
      "page_id": "p03",
      "text": "A careful observer compares more than one example. A repeated result is stronger evidence than a single surprising event.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "A careful observer compares more than one example. A repeated result is stronger evidence than a single surprising event.",
      "timing_segments": []
    },
    {
      "page_id": "p04",
      "text": "Measurements add useful detail. They can describe direction, amount, distance, or time instead of relying on a guess.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "Measurements add useful detail. They can describe direction, amount, distance, or time instead of relying on a guess.",
      "timing_segments": []
    },
    {
      "page_id": "p05",
      "text": "Conditions can change the result. That is why investigators note the place, weather, light, and other important surroundings.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "Conditions can change the result. That is why investigators note the place, weather, light, and other important surroundings.",
      "timing_segments": []
    },
    {
      "page_id": "p06",
      "text": "Scientists use evidence to choose between explanations. An idea that fits all the observations is stronger than one that fits only one clue.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "Scientists use evidence to choose between explanations. An idea that fits all the observations is stronger than one that fits only one clue.",
      "timing_segments": []
    },
    {
      "page_id": "p07",
      "text": "The explanation may change when new evidence appears. Revising an idea helps make it more accurate, not less useful.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "The explanation may change when new evidence appears. Revising an idea helps make it more accurate, not less useful.",
      "timing_segments": []
    },
    {
      "page_id": "p08",
      "text": "The main idea of a river changes course joins the observations into one account. A reader can check that account against the evidence on each page.",
      "illustration_brief": "Diagram or scene about water without printed labels; do not reveal the page's exact wording.",
      "audio_script": "The main idea of a river changes course joins the observations into one account. A reader can check that account against the evidence on each page.",
